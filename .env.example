# ═══════════════════════════════════════════════════════════════════
#  JARVIS — Environment Configuration
#  Copy this to .env and fill in ONLY the provider you want to use
# ═══════════════════════════════════════════════════════════════════

# ── Choose your AI provider (pick one) ──────────────────────────────
# groq   → FREE, fast, great quality  (recommended)
# gemini → FREE, Google AI
# ollama → FREE, 100% offline, no key needed
# claude → PAID, Anthropic Claude
AI_PROVIDER=groq

# ── GROQ (Free — recommended) ────────────────────────────────────────
# Sign up free at: https://console.groq.com/
# Free tier: 14,400 requests/day, Llama 3.3 70B model
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── GOOGLE GEMINI (Free) ─────────────────────────────────────────────
# Get free key at: https://aistudio.google.com/app/apikey
# Free tier: 15 req/min, 1 million tokens/day
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── OLLAMA (100% Offline, No Key Needed) ─────────────────────────────
# Install Ollama: https://ollama.com/download
# Then run once: ollama pull llama3.2
# Then: ollama serve   (keep it running)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── CLAUDE (Paid — optional) ─────────────────────────────────────────
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# ── Optional: ElevenLabs natural voice TTS ───────────────────────────
# Leave empty to use pyttsx3 (free offline TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
